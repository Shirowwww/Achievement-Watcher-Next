<UserControl x:Class="AwNext.Playnite.Views.AwNextSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource LOCAwNextSettingsIntro}" TextWrapping="Wrap" Margin="0,0,0,15" />
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource LOCAwNextPort}" Width="200" VerticalAlignment="Center" />
            <TextBox Text="{Binding Settings.Port}" Width="100" HorizontalAlignment="Left" />
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{DynamicResource LOCAwNextLogin}" Width="200" VerticalAlignment="Center" />
            <TextBox Text="{Binding Settings.Login}" Width="250" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBlock Text="{DynamicResource LOCAwNextLoginHint}" TextWrapping="Wrap" Margin="200,5,0,0" Opacity="0.7" />
    </StackPanel>
</UserControl>
