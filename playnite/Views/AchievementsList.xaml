<UserControl x:Class="AwNext.Playnite.Views.AchievementsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Message" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{DynamicResource LOCAwNextLoading}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Loading">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{DynamicResource LOCAwNextOffline}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Offline">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{DynamicResource LOCAwNextNotFound}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Message}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="NotFound">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Ready">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,6" />
            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,0,10" />

            <ItemsControl x:Name="List" ItemsSource="{Binding ElementName=Root, Path=ShownItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8" Background="Transparent" MouseLeftButtonUp="Item_Click">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanReveal}" Value="True">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="{DynamicResource LOCAwNextReveal}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="4" Background="{DynamicResource NormalBrush}" VerticalAlignment="Top">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Unlocked}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}" Opacity="0.8" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,0" MaxWidth="360" HorizontalAlignment="Left" Width="360"
                                             Visibility="{Binding HasProgress, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="ShowAll" Content="{DynamicResource LOCAwNextShowAll}" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Click="ShowAll_Click" Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
