; AW Next - NSIS customizations.
; This file is prepended to the script generated by electron-builder.
;
; What the user sees is drawn by AwSetupUi.dll (native/setup-ui, a Direct2D window in the app's
; style). Everything else stays electron-builder's: sections, registry, shortcuts, the multi-user
; logic and the command line electron-updater relies on (--updated, /S, --force-run). The plug-in
; sits in build/x86-unicode, which electron-builder adds to the plug-in path by itself.
;
; docs/INSTALLER_AND_UPDATES.md describes what the installer, the uninstaller and the updater each
; do, and why.

; Draw at the screen's real scale. Without it Windows renders the fallback pages at 96 DPI and
; stretches them, so at 125-150% scaling, the usual setting on a gaming PC, all text came out blurry.
ManifestDPIAware true

!define MUI_CUSTOMFUNCTION_GUIINIT AwGuiInit
!define MUI_CUSTOMFUNCTION_UNGUIINIT un.AwGuiInit

Var AwUi              ; "ok" while the setup window is up; anything else means NSIS's own pages
Var unDeleteAppData   ; uninstaller: also delete the user data
!ifndef BUILD_UNINSTALLER
  Var AwDesktop       ; "0" when the user asked for no desktop shortcut
  Var AwChosenDir     ; the folder picked in the window, read back by an elevated instance
  Var AwAskScreen     ; where the choices open: the welcome, or the options after a declined UAC
!endif

!macro customHeader
  ; Only the fallback pages (when the window cannot be created) show these.
  ShowInstDetails show
  ShowUninstDetails show
!macroend

; ---------------------------------------------------------------------------
; Language: the one picked in the app's Settings once it has run, otherwise the Windows display
; language instead of always defaulting to English (no language dialog is shown). The setup window
; reads the same $LANGUAGE.
;
; NSIS on its own only picks a language whose LANGID matches exactly, so every
; regional variant it has no file for - fr-CA, fr-BE, de-AT, de-CH, it-CH, all
; the es-* of Latin America, zh-HK... - used to fall back to English. Matching
; the PRIMARY language (LANGID & 0x3FF) covers all of them; only Portuguese and
; Chinese need the sublanguage, because each has two installer languages.
; ---------------------------------------------------------------------------
!macro AW_PICK_LANGUAGE
  System::Call 'kernel32::GetUserDefaultUILanguage() i .r0'
  IntOp $1 $0 & 0x3FF

  ; ${Switch} compares strings, so the primary language IDs are written in decimal.
  ${Switch} $1
    ${Case} 9
      StrCpy $LANGUAGE ${LANG_ENGLISH}
      ${Break}
    ${Case} 12
      StrCpy $LANGUAGE ${LANG_FRENCH}
      ${Break}
    ${Case} 7
      StrCpy $LANGUAGE ${LANG_GERMAN}
      ${Break}
    ${Case} 10
      StrCpy $LANGUAGE ${LANG_SPANISHINTERNATIONAL}
      ${Break}
    ${Case} 16
      StrCpy $LANGUAGE ${LANG_ITALIAN}
      ${Break}
    ${Case} 22
      ${If} $0 == 1046 ; pt-BR
        StrCpy $LANGUAGE ${LANG_PORTUGUESEBR}
      ${Else}
        StrCpy $LANGUAGE ${LANG_PORTUGUESE}
      ${EndIf}
      ${Break}
    ${Case} 5
      StrCpy $LANGUAGE ${LANG_CZECH}
      ${Break}
    ${Case} 27
      StrCpy $LANGUAGE ${LANG_SLOVAK}
      ${Break}
    ${Case} 14
      StrCpy $LANGUAGE ${LANG_HUNGARIAN}
      ${Break}
    ${Case} 21
      StrCpy $LANGUAGE ${LANG_POLISH}
      ${Break}
    ${Case} 25
      StrCpy $LANGUAGE ${LANG_RUSSIAN}
      ${Break}
    ${Case} 34
      StrCpy $LANGUAGE ${LANG_UKRAINIAN}
      ${Break}
    ${Case} 31
      StrCpy $LANGUAGE ${LANG_TURKISH}
      ${Break}
    ${Case} 30
      StrCpy $LANGUAGE ${LANG_THAI}
      ${Break}
    ${Case} 17
      StrCpy $LANGUAGE ${LANG_JAPANESE}
      ${Break}
    ${Case} 4
      ; zh-TW (1028), zh-HK (3076) and zh-MO (5124) read Traditional Chinese.
      ${If} $0 == 1028
      ${OrIf} $0 == 3076
      ${OrIf} $0 == 5124
        StrCpy $LANGUAGE ${LANG_TRADCHINESE}
      ${Else}
        StrCpy $LANGUAGE ${LANG_SIMPCHINESE}
      ${EndIf}
      ${Break}
    ${Case} 6
      StrCpy $LANGUAGE ${LANG_DANISH}
      ${Break}
    ${Case} 19
      StrCpy $LANGUAGE ${LANG_DUTCH}
      ${Break}
    ${Case} 11
      StrCpy $LANGUAGE ${LANG_FINNISH}
      ${Break}
    ${Case} 8
      StrCpy $LANGUAGE ${LANG_GREEK}
      ${Break}
    ${Case} 33
      StrCpy $LANGUAGE ${LANG_INDONESIAN}
      ${Break}
    ${Case} 18
      StrCpy $LANGUAGE ${LANG_KOREAN}
      ${Break}
    ${Case} 20
      ; Bokmal and Nynorsk both read the Norwegian installer.
      StrCpy $LANGUAGE ${LANG_NORWEGIAN}
      ${Break}
    ${Case} 29
      StrCpy $LANGUAGE ${LANG_SWEDISH}
      ${Break}
    ${Case} 42
      StrCpy $LANGUAGE ${LANG_VIETNAMESE}
      ${Break}
  ${EndSwitch}
  !insertmacro AW_PICK_APP_LANGUAGE
!macroend

; Once AW Next has run, the language picked in its Settings wins over Windows': an update, a
; reinstall and the uninstaller speak the language the app speaks. The ids are the file names of
; app/locale/lang/*.json; Latin American Spanish reads the Spanish installer. The profile is found
; through the environment because .onInit may already be in the all-users shell context.
!macro AW_PICK_APP_LANGUAGE
  ReadEnvStr $2 APPDATA
  ReadINIStr $2 "$2\Achievement Watcher Next\cfg\options.ini" "achievement" "lang"
  ${Switch} $2
    ${Case} "english"
      StrCpy $LANGUAGE ${LANG_ENGLISH}
      ${Break}
    ${Case} "french"
      StrCpy $LANGUAGE ${LANG_FRENCH}
      ${Break}
    ${Case} "german"
      StrCpy $LANGUAGE ${LANG_GERMAN}
      ${Break}
    ${Case} "spanish"
    ${Case} "latam"
      StrCpy $LANGUAGE ${LANG_SPANISHINTERNATIONAL}
      ${Break}
    ${Case} "italian"
      StrCpy $LANGUAGE ${LANG_ITALIAN}
      ${Break}
    ${Case} "portuguese"
      StrCpy $LANGUAGE ${LANG_PORTUGUESE}
      ${Break}
    ${Case} "brazilian"
      StrCpy $LANGUAGE ${LANG_PORTUGUESEBR}
      ${Break}
    ${Case} "czech"
      StrCpy $LANGUAGE ${LANG_CZECH}
      ${Break}
    ${Case} "slovak"
      StrCpy $LANGUAGE ${LANG_SLOVAK}
      ${Break}
    ${Case} "hungarian"
      StrCpy $LANGUAGE ${LANG_HUNGARIAN}
      ${Break}
    ${Case} "polish"
      StrCpy $LANGUAGE ${LANG_POLISH}
      ${Break}
    ${Case} "russian"
      StrCpy $LANGUAGE ${LANG_RUSSIAN}
      ${Break}
    ${Case} "ukrainian"
      StrCpy $LANGUAGE ${LANG_UKRAINIAN}
      ${Break}
    ${Case} "turkish"
      StrCpy $LANGUAGE ${LANG_TURKISH}
      ${Break}
    ${Case} "thai"
      StrCpy $LANGUAGE ${LANG_THAI}
      ${Break}
    ${Case} "japanese"
      StrCpy $LANGUAGE ${LANG_JAPANESE}
      ${Break}
    ${Case} "schinese"
      StrCpy $LANGUAGE ${LANG_SIMPCHINESE}
      ${Break}
    ${Case} "tchinese"
      StrCpy $LANGUAGE ${LANG_TRADCHINESE}
      ${Break}
    ${Case} "danish"
      StrCpy $LANGUAGE ${LANG_DANISH}
      ${Break}
    ${Case} "dutch"
      StrCpy $LANGUAGE ${LANG_DUTCH}
      ${Break}
    ${Case} "finnish"
      StrCpy $LANGUAGE ${LANG_FINNISH}
      ${Break}
    ${Case} "greek"
      StrCpy $LANGUAGE ${LANG_GREEK}
      ${Break}
    ${Case} "indonesian"
      StrCpy $LANGUAGE ${LANG_INDONESIAN}
      ${Break}
    ${Case} "koreana"
      StrCpy $LANGUAGE ${LANG_KOREAN}
      ${Break}
    ${Case} "norwegian"
      StrCpy $LANGUAGE ${LANG_NORWEGIAN}
      ${Break}
    ${Case} "swedish"
      StrCpy $LANGUAGE ${LANG_SWEDISH}
      ${Break}
    ${Case} "vietnamese"
      StrCpy $LANGUAGE ${LANG_VIETNAMESE}
      ${Break}
  ${EndSwitch}
!macroend

!macro customInit
  !insertmacro AW_PICK_LANGUAGE
!macroend

!macro customUnInit
  !insertmacro AW_PICK_LANGUAGE
!macroend

; ---------------------------------------------------------------------------
; Pages. electron-builder's assisted page list (welcome, license, install mode, directory,
; progress, finish) is replaced by three steps, each drawn by the setup window:
;
;   installer    choices (welcome + options) -> progress -> done
;   uninstaller  confirmation -> progress -> removed
;
; The progress step is still NSIS's own instfiles page, so the sections run exactly as before; its
; dialog is only made invisible behind the window. A page whose window could not be created falls
; back to plain NSIS behaviour: default choices and the stock progress page.
;
; An --updated run (electron-updater) skips the choices and shows a compact progress card instead.
; ---------------------------------------------------------------------------
!macro customPages
  !ifndef BUILD_UNINSTALLER
    Page custom AwChoicesCreate
    !define MUI_PAGE_CUSTOMFUNCTION_SHOW AwProgressShow
    !insertmacro MUI_PAGE_INSTFILES
    Page custom AwDoneCreate
    !insertmacro AwInstallerFunctions
  !else
    UninstPage custom un.AwConfirmCreate
    !define MUI_PAGE_CUSTOMFUNCTION_SHOW un.AwProgressShow
    !insertmacro MUI_UNPAGE_INSTFILES
    UninstPage custom un.AwRemovedCreate
    !insertmacro AwUninstallerFunctions
  !endif
!macroend

; Reports a step of the run to the window. Safe to call with no window.
!macro customProgressPhase NAME
  ${If} $AwUi == "ok"
    AwSetupUi::Phase "${NAME}"
  ${EndIf}
!macroend

!macro AwInstallerFunctions
  Function AwGuiInit
    StrCpy $AwUi "off"
    InitPluginsDir
    File "/oname=$PLUGINSDIR\license.txt" "${BUILD_RESOURCES_DIR}\license.txt"
    ReadRegStr $0 SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" DisplayVersion
    AwSetupUi::Set "version" "${VERSION}"
    AwSetupUi::Set "oldversion" "$0"
    AwSetupUi::Set "dir" "$INSTDIR"
    AwSetupUi::Set "dirall" "$PROGRAMFILES64\${APP_FILENAME}"
    AwSetupUi::Set "license" "$PLUGINSDIR\license.txt"
    ; The per-user default, whichever mode the previous install used.
    ${If} $installMode == "all"
      SetShellVarContext current
    ${EndIf}
    AwSetupUi::Set "diruser" "$LOCALAPPDATA\Programs\${APP_FILENAME}"
    ${If} $installMode == "all"
      SetShellVarContext all
      AwSetupUi::Set "allusers" "1"
    ${EndIf}
    ; A reinstall keeps the user's earlier choice about the desktop shortcut.
    StrCpy $AwDesktop "1"
    ReadRegStr $1 SHELL_CONTEXT "${INSTALL_REGISTRY_KEY}" ShortcutName
    ${If} $1 != ""
    ${AndIfNot} ${FileExists} "$DESKTOP\$1.lnk"
      StrCpy $AwDesktop "0"
    ${EndIf}
    AwSetupUi::Set "desktop" "$AwDesktop"
    SectionGetSize 0 $1
    AwSetupUi::Set "requiredkb" "$1"
    ${If} ${isUpdated}
      AwSetupUi::Init "update"
    ${Else}
      AwSetupUi::Init "install"
    ${EndIf}
    Pop $AwUi
  FunctionEnd

  ; The install mode an --updated run inherits from the installation it replaces (installing it in
  ; the other mode would leave the user with two copies), elevating first for an all-users one.
  Function AwUpdateMode
    ${If} $hasPerMachineInstallation == "1"
      ${IfNot} ${UAC_IsAdmin}
        ${If} $AwUi == "ok"
          AwSetupUi::Hide
          Pop $0
        ${EndIf}
        !insertmacro UAC_RunElevated
        Quit
      ${EndIf}
      !insertmacro setInstallModePerAllUsers
    ${Else}
      !insertmacro setInstallModePerUser
    ${EndIf}
  FunctionEnd

  ; Never install into the picked folder itself: the uninstaller removes the whole installation
  ; folder, so "D:\Games" must become "D:\Games\Achievement Watcher". The window does the same.
  Function AwKeepAppFolder
    ${GetFileName} "$AwChosenDir" $0
    ${If} $0 != "${APP_FILENAME}"
      StrCpy $AwChosenDir "$AwChosenDir\${APP_FILENAME}"
    ${EndIf}
  FunctionEnd

  Function AwChoicesCreate
    ${If} ${isUpdated}
      Call AwUpdateMode
      Abort
    ${EndIf}
    ${If} ${UAC_IsInnerInstance}
      ; The elevated half of an all-users install: the choices were made in the outer window.
      !insertmacro UAC_AsUser_GetGlobalVar $AwChosenDir
      !insertmacro UAC_AsUser_GetGlobalVar $AwDesktop
      !insertmacro setInstallModePerAllUsers
      ${If} $AwChosenDir != ""
        StrCpy $INSTDIR $AwChosenDir
      ${EndIf}
      Abort
    ${EndIf}
    ${If} $AwUi != "ok"
      Abort
    ${EndIf}
    StrCpy $AwAskScreen "welcome"
    awAsk:
    AwSetupUi::Show "$AwAskScreen"
    Pop $0
    ${If} $0 != "next"
      Quit
    ${EndIf}
    AwSetupUi::Get "dir"
    Pop $AwChosenDir
    Call AwKeepAppFolder
    AwSetupUi::Get "desktop"
    Pop $AwDesktop
    AwSetupUi::Get "allusers"
    Pop $0
    ${If} $0 == "1"
      ${IfNot} ${UAC_IsAdmin}
        AwSetupUi::Hide
        Pop $0
        !insertmacro UAC_RunElevated
        ${If} $0 == 0
        ${AndIf} $1 == 1
          Quit ; the elevated instance ran the install and showed its end
        ${EndIf}
        ; Elevation declined or failed: back to the options, where "Just me" is one click away.
        StrCpy $AwAskScreen "options"
        Goto awAsk
      ${EndIf}
      !insertmacro setInstallModePerAllUsers
    ${Else}
      !insertmacro setInstallModePerUser
    ${EndIf}
    StrCpy $INSTDIR $AwChosenDir
    Abort
  FunctionEnd

  ; Without MUI's finish page nothing turns AutoCloseWindow on, and the progress page would wait
  ; for a click on its (invisible) Next button once the files are in.
  Function AwProgressShow
    SetAutoClose true
    ${If} $AwUi == "ok"
      AwSetupUi::Show "progress"
      Pop $0
    ${EndIf}
  FunctionEnd

  ; The template's own StartApp body: launch as the signed-in user, with --updated after an update.
  Function AwStartApp
    ${If} ${isUpdated}
      StrCpy $1 "--updated"
    ${Else}
      StrCpy $1 ""
    ${EndIf}
    ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$1"
  FunctionEnd

  Function AwDoneCreate
    StrCpy $0 "launch"
    ${If} $AwUi == "ok"
      AwSetupUi::Show "done"
      Pop $0
      AwSetupUi::Close
      Pop $1
    ${EndIf}
    ${If} $0 == "launch"
      HideWindow
      Call AwStartApp
    ${EndIf}
    !insertmacro quitSuccess
  FunctionEnd

  Function .onInstFailed
    ${If} $AwUi == "ok"
      AwSetupUi::Show "error"
      Pop $0
      AwSetupUi::Close
      Pop $1
      ${If} $0 == "retry"
        Exec '"$EXEPATH"'
      ${EndIf}
      Quit
    ${EndIf}
  FunctionEnd

  ; Progress of the archive extraction, called by Nsis7z with the bytes done and the total.
  Function AwExtractProgress
    Exch $R8
    Exch
    Exch $R9
    AwSetupUi::Progress "$R8" "$R9"
    Pop $R9
    Pop $R8
  FunctionEnd
!macroend

!macro customExtract7z FILE
  ${If} $AwUi == "ok"
    Push $R9
    GetFunctionAddress $R9 AwExtractProgress
    Nsis7z::ExtractWithCallback "${FILE}" $R9
    Pop $R9
  ${Else}
    Nsis7z::Extract "${FILE}"
  ${EndIf}
!macroend

; The archive is extracted to $PLUGINSDIR first, then copied into the installation folder: 430 MB
; written twice. For a per-user install both folders live in the same profile, so moving each
; top-level entry is a rename that costs nothing. electron-builder's copy that follows then only has
; what could not be moved (another volume, a leftover file), with its retry loop intact. An
; all-users install keeps the copy: a moved file keeps the ACL of the user's temp folder instead of
; inheriting Program Files', and other accounts could not read it.
!macro customMoveExtractedFiles
  !insertmacro customProgressPhase "placing"
  ${If} $installMode != "all"
    Push $R6
    Push $R7
    FindFirst $R6 $R7 "$PLUGINSDIR\7z-out\*"
    ${DoWhile} $R7 != ""
      ${If} $R7 != "."
      ${AndIf} $R7 != ".."
      ${AndIfNot} ${FileExists} "$OUTDIR\$R7"
        Rename "$PLUGINSDIR\7z-out\$R7" "$OUTDIR\$R7"
      ${EndIf}
      FindNext $R6 $R7
    ${Loop}
    FindClose $R6
    ClearErrors
    Pop $R7
    Pop $R6
  ${EndIf}
!macroend

!macro AwUninstallerFunctions
  ; The uninstaller is compiled from the same script and MUI still emits the installer's
  ; .onGUIInit there, which calls the GUIINIT hook: it has nothing to do in that build.
  Function AwGuiInit
  FunctionEnd

  Function un.AwGuiInit
    StrCpy $AwUi "off"
    AwSetupUi::Set "version" "${VERSION}"
    AwSetupUi::Set "dir" "$INSTDIR"
    ; Electron keeps per-user data even for an all-users install.
    ${If} $installMode == "all"
      SetShellVarContext current
    ${EndIf}
    AwSetupUi::Set "datafolder" "$APPDATA\Achievement Watcher Next"
    AwSetupUi::Set "datafolder" "$APPDATA\Achievement Watcher 3.0"
    ${If} $installMode == "all"
      SetShellVarContext all
    ${EndIf}
    AwSetupUi::Set "datashown" "%APPDATA%\Achievement Watcher Next"
    AwSetupUi::Init "uninstall"
    Pop $AwUi
  FunctionEnd

  ; Which installation this uninstaller removes, elevating first for an all-users one. With both a
  ; per-user and an all-users copy, it is the one this uninstaller belongs to.
  Function un.AwPickMode
    ${If} $hasPerMachineInstallation == "1"
    ${AndIf} $hasPerUserInstallation == "1"
      ${If} $INSTDIR == $perMachineInstallationFolder
        StrCpy $hasPerUserInstallation "0"
      ${Else}
        StrCpy $hasPerMachineInstallation "0"
      ${EndIf}
    ${EndIf}
    ${If} $hasPerMachineInstallation == "1"
      ${IfNot} ${UAC_IsAdmin}
      ${AndIf} $AwUi == "ok"
        AwSetupUi::Hide
        Pop $0
      ${EndIf}
      !insertmacro setInstallModePerAllUsers ; elevates, then quits, when not an administrator
    ${Else}
      !insertmacro setInstallModePerUser
    ${EndIf}
  FunctionEnd

  Function un.AwConfirmCreate
    Call un.AwPickMode
    ${If} $AwUi != "ok"
      MessageBox MB_OKCANCEL|MB_ICONQUESTION "$(areYouSureToUninstall)" IDOK +2
      Quit
      Abort
    ${EndIf}
    AwSetupUi::Show "confirm"
    Pop $0
    ${If} $0 != "next"
      Quit
    ${EndIf}
    AwSetupUi::Get "deletedata"
    Pop $unDeleteAppData
    Abort
  FunctionEnd

  Function un.AwProgressShow
    SetAutoClose true
    ${If} $AwUi == "ok"
      AwSetupUi::Show "progress"
      Pop $0
    ${EndIf}
  FunctionEnd

  Function un.AwRemovedCreate
    ${If} $AwUi == "ok"
      AwSetupUi::Show "removed"
      Pop $0
      AwSetupUi::Close
      Pop $0
    ${EndIf}
    !insertmacro quitSuccess
  FunctionEnd

  Function un.onUninstFailed
    ${If} $AwUi == "ok"
      AwSetupUi::Show "error"
      Pop $0
      AwSetupUi::Close
      Pop $0
      Quit
    ${EndIf}
  FunctionEnd
!macroend

; ---------------------------------------------------------------------------
; Is AW Next running? Every process whose executable lies in $INSTDIR counts, so the Watchdog (the
; same executable under ELECTRON_RUN_AS_NODE) and the native helpers go with the app, while a
; portable copy elsewhere or another account's install is left alone. Same flow as electron-builder's
; _CHECK_APP_RUNNING: ask, close, force, then let the user retry. With the setup window up, the
; question was already answered there ("AW Next is running, setup will close it first").
;
; The scan and the closing are AwSetupUi::AppRunning and ::CloseApp, which ask Windows directly:
; electron-builder's own check starts PowerShell three times, which sandboxes score as malicious,
; and the System::Call loop that replaced it cost four NSIS instructions per running process, each
; a round trip to the installer window: on a desktop with 600 processes it took 30 seconds.
; ---------------------------------------------------------------------------
!macro customCheckAppRunning
  !insertmacro customProgressPhase "closing"
  Push $0
  ${if} ${isUpdated}
    Sleep 300 ; the app is quitting on its own
  ${endIf}
  AwSetupUi::AppRunning "$INSTDIR"
  Pop $0
  ${if} $0 == "1"
    ${if} ${isUpdated}
      Sleep 1000
    ${elseIf} $AwUi != "ok"
      MessageBox MB_OKCANCEL|MB_ICONEXCLAMATION "$(appRunning)" /SD IDOK IDOK awStopApp
      Quit
    ${endIf}
    awStopApp:
    DetailPrint "$(appClosing)"
    AwSetupUi::CloseApp "$INSTDIR"
    Pop $0
    ${if} $0 != "0"
      ; Most likely running elevated, out of this installer's reach.
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(appCannotBeClosed)" /SD IDCANCEL IDRETRY awStopApp
      Quit
    ${endIf}
  ${endIf}
  Pop $0
  !ifndef BUILD_UNINSTALLER
    !insertmacro customProgressPhase "removing"
  !endif
!macroend

!macro customInstall
  ; A fresh install or a manual reinstall honours the desktop-shortcut choice; an update keeps
  ; whatever the user has (electron-builder never recreates a shortcut on an update).
  ${IfNot} ${isUpdated}
  ${AndIf} $AwDesktop == "0"
    WinShell::UninstShortcut "$newDesktopLink"
    Delete "$newDesktopLink"
    System::Call 'Shell32::SHChangeNotify(i 0x8000000, i 0, i 0, i 0)'
  ${EndIf}

  ; The app copies presets/ and view/ from its own resources on first launch (checkResources in
  ; electron/init.js), so the installer only needs to create the folder. AW Next owns a folder
  ; neither predecessor's uninstaller touches: the legacy 1.6.8 uninstaller deletes
  ; "%APPDATA%\Achievement Watcher", which used to wipe every 3.x setting and cache (issue #6). Data
  ; from an existing "Achievement Watcher 3.0" folder is imported on first launch by
  ; migrateAw3UserData() - the installer never moves user data itself.
  ${If} $installMode == "all"
    SetShellVarContext current
  ${EndIf}
  CreateDirectory "$APPDATA\Achievement Watcher Next"
  ${If} $installMode == "all"
    SetShellVarContext all
  ${EndIf}
!macroend

; Removing the installation folder. electron-builder renames each of the ~2100 files into the
; uninstaller's temp folder one NSIS instruction at a time (so that an update can put them back if
; one is busy), then deletes them all again when it exits: four seconds of every update. Renaming the
; folder itself gives the same guarantee in one step - it fails at once while any file inside is in
; use - and AwSetupUi::RemoveTree then deletes the renamed tree on several threads, reporting
; progress to the window.
!macro customRemoveFiles
  SetOutPath $TEMP ; the uninstaller's working directory must not hold the folder open
  ${if} ${isUpdated}
    AwSetupUi::RemoveTree "$INSTDIR" "atomic"
    Pop $R0
    ${if} $R0 != "ok"
      DetailPrint "File is busy, aborting: $R0"
      Abort `Can't rename "$INSTDIR".`
    ${endif}
  ${else}
    AwSetupUi::RemoveTree "$INSTDIR" "best"
    Pop $R0
    ; Whatever could not be moved or deleted (a file still in use) goes the usual way.
    RMDir /r $INSTDIR
  ${endif}
!macroend

!macro customUnInstall
  ; An update runs the previous version's uninstaller with --updated (electron-builder's
  ; uninstallOldVersion always passes it). Everything below belongs to a REAL uninstall only: an
  ; update that dropped the autostart entry or the update cache would be a regression.
  ;
  ; Electron keeps per-user data even for an all-users install, so every path below is resolved
  ; in the current user's context, exactly as electron-builder's own app-data removal does.
  ${If} $installMode == "all"
    SetShellVarContext current
  ${EndIf}

  ${IfNot} ${isUpdated}
    ; Traces the app writes itself and that would otherwise outlive it:
    ;  - the "Start with Windows" entry (app.setLoginItemSettings; the value is named after the
    ;    AppUserModelID) and Explorer's enabled/disabled flag for it - left behind, Windows tries to
    ;    start a missing executable at every sign-in;
    ;  - the achievement-watcher: protocol the toast buttons open (TOAST_PROTOCOL in init.js);
    ;  - the updater cache: installer.exe (base of the next differential download) and the last
    ;    downloaded installer, 127 MB each. electron-builder only exposes its folder through
    ;    APP_INSTALLER_STORE_FILE ("<updaterCacheDirName>\installer.exe"), hence the parse.
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${APP_ID}"
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run" "${APP_ID}"
    DeleteRegKey HKCU "Software\Classes\achievement-watcher"
    !ifdef APP_INSTALLER_STORE_FILE
      !searchparse /noerrors "${APP_INSTALLER_STORE_FILE}" "" AW_UPDATER_CACHE_DIR "\installer.exe"
      !ifdef AW_UPDATER_CACHE_DIR
        ; An empty match would make this RMDir /r the whole of %LOCALAPPDATA%.
        !if "${AW_UPDATER_CACHE_DIR}" != ""
          RMDir /r "$LOCALAPPDATA\${AW_UPDATER_CACHE_DIR}"
        !endif
        !undef AW_UPDATER_CACHE_DIR
      !endif
    !endif

    ; The window's choice (off by default) or `--delete-app-data` on a silent uninstall. Both folders
    ; this product has owned are removed - "Achievement Watcher 3.0" holds the same user's data,
    ; imported forward on first launch, and leaving it behind would strand hundreds of megabytes of
    ; caches and backups. The legacy 1.6.8 "%APPDATA%\Achievement Watcher" folder stays untouched:
    ; it belongs to a different application that may still be installed (the app-builder-lib patch
    ; stops electron-builder's own --delete-app-data branch from removing it).
    ClearErrors
    ${GetParameters} $R0
    ${GetOptions} $R0 "--delete-app-data" $R1
    ${IfNot} ${Errors}
      StrCpy $unDeleteAppData "1"
    ${EndIf}
    ${If} $unDeleteAppData == "1"
      !insertmacro customProgressPhase "data"
      RMDir /r "$APPDATA\Achievement Watcher Next"
      RMDir /r "$APPDATA\Achievement Watcher 3.0"
      ; Playtime lives in the registry, beside the files (watchdog/playtime/track.js).
      DeleteRegKey HKCU "Software\Achievement Watcher Next"
      DeleteRegKey HKCU "Software\Achievement Watcher 3.0"
    ${EndIf}
  ${EndIf}

  ${If} $installMode == "all"
    SetShellVarContext all
  ${EndIf}
  !insertmacro customProgressPhase "files"
!macroend
