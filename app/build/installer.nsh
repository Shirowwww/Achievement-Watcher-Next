  LangString AW_UNINSTALL_DELETING ${LANG_ENGLISH} "Deleting settings and cached data…"
  LangString AW_UNINSTALL_DELETING ${LANG_FRENCH} "Suppression des paramètres et du cache…"
  LangString AW_UNINSTALL_DELETING ${LANG_GERMAN} "Einstellungen und Cache werden gelöscht…"
  LangString AW_UNINSTALL_DELETING ${LANG_SPANISHINTERNATIONAL} "Eliminando ajustes y caché…"
  LangString AW_UNINSTALL_DELETING ${LANG_ITALIAN} "Eliminazione di impostazioni e cache…"
  LangString AW_UNINSTALL_DELETING ${LANG_PORTUGUESE} "A eliminar definições e cache…"
  LangString AW_UNINSTALL_DELETING ${LANG_PORTUGUESEBR} "Excluindo configurações e cache…"
  LangString AW_UNINSTALL_DELETING ${LANG_CZECH} "Mazání nastavení a mezipaměti…"
  LangString AW_UNINSTALL_DELETING ${LANG_SLOVAK} "Odstraňovanie nastavení a vyrovnávacej pamäte…"
  LangString AW_UNINSTALL_DELETING ${LANG_HUNGARIAN} "Beállítások és gyorsítótár törlése…"
  LangString AW_UNINSTALL_DELETING ${LANG_POLISH} "Usuwanie ustawień i pamięci podręcznej…"
  LangString AW_UNINSTALL_DELETING ${LANG_RUSSIAN} "Удаление настроек и кэша…"
  LangString AW_UNINSTALL_DELETING ${LANG_UKRAINIAN} "Видалення налаштувань і кешу…"
  LangString AW_UNINSTALL_DELETING ${LANG_TURKISH} "Ayarlar ve önbellek siliniyor…"
