     !ifdef BUILD_UNINSTALLER
       ${IfNot} ${UAC_IsAdmin}
         ShowWindow $HWNDPARENT ${SW_HIDE}
+        # Achievement Watcher: un.onInit made $INSTDIR this process's working directory, and this
